#!/usr/bin/env bash
# Append one blocker entry. Run this BEFORE implementing the resolution, so that
# prev_commit records the state the fix was applied to.
#
#   log-blocker "<blocker>" "<resolution>" <low|medium|high> "<risk explanation>"
#
# Reads $CC_WORKER for attribution. Safe to run from any worktree.

set -euo pipefail
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_common.sh"

usage() {
  cat >&2 <<'EOF'
usage: log-blocker "<blocker>" "<resolution>" <low|medium|high> "<risk explanation>"

  blocker           what was blocking, one or two sentences
  resolution        the resolution actually decided on
  risk              confidence in the RESOLUTION: low | medium | high
  risk explanation  the condition under which the resolution is wrong

See .agent/docs/blocker-schema.md for the grading rules.
EOF
  exit 64
}

[ $# -eq 4 ] || usage
BLOCKER="$1"; RESOLUTION="$2"; RISK="$(printf '%s' "$3" | tr '[:upper:]' '[:lower:]')"; WHY="$4"

case "$RISK" in
  low|medium|high) ;;
  *) echo "log-blocker: risk must be low, medium or high (got '$3')" >&2; exit 64 ;;
esac

for f in "$BLOCKER" "$RESOLUTION" "$WHY"; do
  [ -n "${f// /}" ] || { echo "log-blocker: empty field" >&2; exit 64; }
done
if [ "${#WHY}" -lt 20 ]; then
  echo "log-blocker: risk_explanation must say what would make the resolution wrong." >&2
  echo "             '$WHY' is too short to be useful to a reviewer." >&2
  exit 64
fi

have jq || { echo "log-blocker: jq is required" >&2; exit 69; }

SHA="$(git rev-parse HEAD 2>/dev/null || echo 'no-commit')"
BRANCH="$(git branch --show-current 2>/dev/null || echo 'detached')"
NOW_EPOCH="$(date +%s)"
ID="BLK-${NOW_EPOCH}-$(printf '%s' "$SHA" | cut -c1-7)"

TASK=""
if [ -f "${RUNNING_DIR:-$AGENT_DIR/running}/${WORKER}.task" ]; then
  TASK="$(sed -n 's/^id:[[:space:]]*//p' "${RUNNING_DIR:-$AGENT_DIR/running}/${WORKER}.task" | head -1)"
fi

BLOCKER_LOG="${BLOCKER_LOG:-$AGENT_DIR/blockers.jsonl}"
mkdir -p "$(dirname "$BLOCKER_LOG")"

# jq -c emits exactly one line, so concurrent appends from parallel worktrees
# do not interleave (single write below PIPE_BUF).
LINE="$(jq -nc \
  --arg id "$ID" \
  --arg date "$(date -Iseconds)" \
  --arg worker "$WORKER" \
  --arg task "$TASK" \
  --arg branch "$BRANCH" \
  --arg blocker "$BLOCKER" \
  --arg resolution "$RESOLUTION" \
  --arg prev_commit "$SHA" \
  --arg risk "$RISK" \
  --arg why "$WHY" \
  '{id:$id, date:$date, worker:$worker, task:$task, branch:$branch,
    blocker:$blocker, resolution:$resolution, prev_commit:$prev_commit,
    risk:$risk, risk_explanation:$why}')"

printf '%s\n' "$LINE" >> "$BLOCKER_LOG"

# Clears the Stop-hook gate for this turn.
rm -f "$STATE_DIR/${WORKER}.no-blocker"

echo "logged $ID  risk=$RISK  prev_commit=${SHA:0:7}"
