#!/usr/bin/env bash
# File-based task queue. Leases are atomic renames, so parallel workers cannot
# claim the same task.
#
#   queue add <slug> [priority]      create a task stub (priority 10 = default, lower runs first)
#   queue claim <worker>             lease the highest-priority task; prints its path
#   queue complete <worker> <note>   finish the leased task
#   queue release <worker> [reason]  return the leased task to the queue
#   queue reap [minutes]             return leases idle longer than N minutes
#   queue status                     one-screen summary
#   queue next                       print the next task filename without claiming

set -euo pipefail
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_common.sh"

QUEUE_DIR="${QUEUE_DIR:-$AGENT_DIR/queue}"
RUNNING_DIR="${RUNNING_DIR:-$AGENT_DIR/running}"
DONE_DIR="${DONE_DIR:-$AGENT_DIR/done}"
mkdir -p "$QUEUE_DIR" "$RUNNING_DIR" "$DONE_DIR"

# Sort key is the leading priority in the filename: NNN-slug.md
_sorted_queue() { ls "$QUEUE_DIR" 2>/dev/null | grep -E '\.md$' | sort; }

cmd_add() {
  local slug="${1:?usage: queue add <slug> [priority]}" prio="${2:-10}"
  slug="$(printf '%s' "$slug" | tr '[:upper:] ' '[:lower:]-' | tr -cd 'a-z0-9-')"
  local id file
  id="$(printf '%03d' "$prio")-$slug"
  file="$QUEUE_DIR/$id.md"
  [ -e "$file" ] && { echo "queue: $file already exists" >&2; exit 1; }
  cat > "$file" <<EOF
---
id: $id
created: $(date -Iseconds)
priority: $prio
---

# Goal

<one paragraph: what should be true when this is done>

# Acceptance criteria

- [ ] <observable, checkable>
- [ ] <observable, checkable>

# Constraints

- <files or subsystems that are out of scope>

# Notes

<links, prior art, anything the worker would otherwise have to rediscover>
EOF
  echo "$file"
}

cmd_next() { _sorted_queue | head -1; }

cmd_claim() {
  local worker="${1:?usage: queue claim <worker>}"
  local dest="$RUNNING_DIR/$worker.task"
  [ -e "$dest" ] && { echo "queue: $worker already holds $(basename "$dest")" >&2; exit 1; }
  local f
  for f in $(_sorted_queue); do
    # rename(2) is atomic: a racing worker gets ENOENT and we move on.
    if mv "$QUEUE_DIR/$f" "$dest" 2>/dev/null; then
      {
        echo ""
        echo "---"
        echo "claimed_by: $worker"
        echo "claimed_at: $(date -Iseconds)"
        echo "source_file: $f"
      } >> "$dest"
      touch "$STATE_DIR/$worker.lease"
      echo "$dest"
      return 0
    fi
  done
  return 1   # queue empty
}

cmd_complete() {
  local worker="${1:?usage: queue complete <worker> <note>}"; shift
  local note="${*:-done}"
  local src="$RUNNING_DIR/$worker.task"
  [ -f "$src" ] || { echo "queue: $worker holds no task" >&2; exit 1; }
  local id dest
  id="$(sed -n 's/^id:[[:space:]]*//p' "$src" | head -1)"
  dest="$DONE_DIR/$(date +%Y%m%d-%H%M%S)-${id:-task}.md"
  {
    echo ""
    echo "---"
    echo "completed_at: $(date -Iseconds)"
    echo "completed_by: $worker"
    echo "outcome: $note"
    echo "final_commit: $(git rev-parse HEAD 2>/dev/null || echo unknown)"
    echo "branch: $(git branch --show-current 2>/dev/null || echo unknown)"
  } >> "$src"
  mv "$src" "$dest"
  rm -f "$STATE_DIR/$worker.lease"
  echo "$dest"
}

cmd_release() {
  local worker="${1:?usage: queue release <worker> [reason]}"; shift
  local reason="${*:-released}"
  local src="$RUNNING_DIR/$worker.task"
  [ -f "$src" ] || { echo "queue: $worker holds no task" >&2; exit 1; }
  local orig
  orig="$(sed -n 's/^source_file:[[:space:]]*//p' "$src" | head -1)"
  orig="${orig:-$(printf '%03d' 5)-requeued-$(date +%s).md}"
  { echo ""; echo "released_at: $(date -Iseconds)  reason: $reason"; } >> "$src"
  mv "$src" "$QUEUE_DIR/$orig"
  rm -f "$STATE_DIR/$worker.lease"
  echo "$QUEUE_DIR/$orig"
}

cmd_reap() {
  local mins="${1:-${STALE_LEASE_MINUTES:-90}}" f worker
  for f in "$RUNNING_DIR"/*.task; do
    [ -e "$f" ] || continue
    worker="$(basename "$f" .task)"
    if [ -z "$(find "$f" -mmin "-$mins" 2>/dev/null)" ]; then
      echo "reaping $worker (idle > ${mins}m)"
      cmd_release "$worker" "stale lease, idle > ${mins}m" >/dev/null
    fi
  done
}

cmd_status() {
  printf 'queued    %s\n' "$(_sorted_queue | wc -l | tr -d ' ')"
  printf 'running   %s\n' "$(ls "$RUNNING_DIR"/*.task 2>/dev/null | wc -l | tr -d ' ')"
  printf 'done      %s\n' "$(ls "$DONE_DIR"/*.md 2>/dev/null | wc -l | tr -d ' ')"
  printf 'blockers  %s\n' "$(wc -l < "${BLOCKER_LOG:-$AGENT_DIR/blockers.jsonl}" 2>/dev/null || echo 0)"
  echo
  local f worker age
  for f in "$RUNNING_DIR"/*.task; do
    [ -e "$f" ] || continue
    worker="$(basename "$f" .task)"
    age="$(sed -n 's/^claimed_at:[[:space:]]*//p' "$f" | head -1)"
    printf '  %-6s %-40s since %s\n' "$worker" \
      "$(sed -n 's/^id:[[:space:]]*//p' "$f" | head -1)" "$age"
  done
  echo
  _sorted_queue | head -10 | sed 's/^/  queued: /'
}

case "${1:-status}" in
  add)      shift; cmd_add "$@" ;;
  claim)    shift; cmd_claim "$@" ;;
  complete) shift; cmd_complete "$@" ;;
  release)  shift; cmd_release "$@" ;;
  reap)     shift; cmd_reap "$@" ;;
  next)     shift; cmd_next ;;
  status)   cmd_status ;;
  *) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 64 ;;
esac
