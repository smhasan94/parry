# ── Clerk (auth) ─────────────────────────────────────────────
# Get your publishable key from https://dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# ── API ──────────────────────────────────────────────────────
# Leave empty when using Vite proxy (default dev setup)
# Set to full URL when backend runs on a different host
VITE_API_URL=

# ── Proxy target (used by vite.config.ts) ────────────────────
# Automatically set to http://backend:8000 in Docker Compose.
# Only override if running Vite dev server against a remote backend.
# VITE_API_PROXY_TARGET=http://localhost:8000
