# Parry on-prem backend image.
#
# Built from the same source tree as the SaaS image but configured
# for air-gapped deployment:
#
#   * ON_PREM_MODE=true is hard-coded at build time (customers can't
#     accidentally run a SaaS image in their VPC)
#   * LICENSE_PUBLIC_KEY_PEM is injected via build arg, not env —
#     the key is part of the image identity, not a runtime config,
#     so every on-prem customer gets a provenance-auditable image
#   * No default Stripe / Clerk / Anthropic values — the startup
#     validator will complain if any SaaS-only setting is in use
#   * ENTRYPOINT runs migrations then uvicorn, in one shot, so the
#     customer doesn't need a separate sidecar
#
# Build example (from the backend/ dir):
#
#   docker build -f Dockerfile.onprem \
#     --build-arg LICENSE_PUBLIC_KEY_PEM="$(cat ../keys/parry_license_ed25519.pub)" \
#     -t parry/backend-onprem:0.1.0 .

ARG LICENSE_PUBLIC_KEY_PEM=""

# ── Build stage ──
FROM python:3.12-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

COPY pyproject.toml uv.lock ./
RUN uv sync --no-install-project

COPY . .
RUN uv sync

# ── Runtime stage ──
FROM python:3.12-slim

ARG LICENSE_PUBLIC_KEY_PEM

WORKDIR /app

# Runtime system deps:
#  - WeasyPrint (Pango/Cairo) for compliance reports
#  - ca-certificates for HTTPS to the local LLM server, which is the
#    ONLY network call an on-prem box is expected to make
RUN apt-get update && apt-get install -y --no-install-recommends \
    fonts-liberation \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libcairo2 \
    libgdk-pixbuf-2.0-0 \
    shared-mime-info \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
COPY --from=builder /app /app

RUN chmod +x /app/entrypoint.sh

# Bake the license public key into the image identity. Using ENV
# means the backend reads it through normal settings loading without
# needing a sidecar volume.
ENV ON_PREM_MODE=true
ENV LICENSE_PATH=/etc/parry/parry.license
ENV LICENSE_PUBLIC_KEY_PEM=${LICENSE_PUBLIC_KEY_PEM}

# The license file itself must be mounted at runtime — it belongs
# to the customer and is issued per-install.
VOLUME ["/etc/parry"]

EXPOSE 8000

ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["uv", "run", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
