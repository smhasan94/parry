# Caddy reverse proxy for Parry production deployment.
#
# Caddy automatically obtains and renews Let's Encrypt certificates for the
# DOMAIN env var. Routes:
#   /api/*    → backend (FastAPI)
#   /health   → backend (for uptime checks)
#   /metrics  → backend (Prometheus scrape — keep behind a firewall in prod)
#   /         → dashboard (nginx serving the React SPA)
#
# To run:
#   DOMAIN=parry.example.com CADDY_EMAIL=ops@example.com docker compose -f docker-compose.prod.yml up -d

{$DOMAIN} {
	encode gzip zstd

	# Health, metrics, and API → backend
	@backend {
		path /api/* /health /metrics
	}
	handle @backend {
		reverse_proxy backend:8000
	}

	# Everything else → dashboard (React SPA)
	handle {
		reverse_proxy dashboard:80
	}

	# Sensible logging — Caddy writes to stdout by default
	log {
		output stdout
		format console
	}

	# Security headers
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Clerk-specific allowances:
		#   script-src — Clerk loads clerk-js@5 from <instance>.clerk.accounts.dev at runtime
		#   frame-src — Clerk uses Cloudflare Turnstile challenges to fight bot signups
		#   worker-src 'self' blob: — Clerk spawns web workers for crypto / session work
		# The connect-src already covers Clerk API calls. We don't allowlist
		# img.clerk.com explicitly because the existing img-src https: already covers it.
		Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net https://*.clerk.accounts.dev https://*.clerk.dev https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://*.clerk.accounts.dev https://*.clerk.dev; font-src 'self'; frame-src 'self' https://challenges.cloudflare.com; worker-src 'self' blob:; frame-ancestors 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}
