# ── App ──────────────────────────────────────────────────────
APP_ENV=development                        # development | production
APP_SECRET_KEY=change-me-in-production     # used for signing internal tokens
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://parry:parry@localhost:5432/parry
# TimescaleDB extension is enabled via docker-compose automatically
# For docker-compose.prod.yml:
POSTGRES_PASSWORD=parry
# POSTGRES_USER=parry
# POSTGRES_DB=parry

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Anthropic (LLM fallback detector) ────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Clerk (auth) ─────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# ── Stripe (billing) ─────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_GROWTH=price_...
STRIPE_PRICE_ID_PRO=price_...

# ── Internal service auth ────────────────────────────────────
# Used for SDK → backend authentication (separate from user API keys)
PARRY_INTERNAL_SECRET=change-me

# ── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Dashboard URL (used in Slack alert links) ────────────────
DASHBOARD_URL=http://localhost:5173

# ── SMTP (email alerts) ──────────────────────────────────────
# Works with any SMTP provider: SendGrid, Mailgun, AWS SES, Postmark, Gmail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@parry.dev
SMTP_USE_TLS=true

# ── Sentry (error tracking — optional) ───────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=
# Frontend (Vite)
VITE_SENTRY_DSN=

# ── Dashboard (Vite env vars — prefix with VITE_) ────────────
VITE_API_URL=http://localhost:8000
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
