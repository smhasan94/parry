# ── App ──────────────────────────────────────────────────────
APP_ENV=development                        # development | production
APP_SECRET_KEY=change-me-in-production     # used for signing internal tokens
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://parry:parry@localhost:5432/parry
# TimescaleDB extension is enabled via docker-compose automatically
# For docker-compose.prod.yml:
POSTGRES_PASSWORD=parry
# POSTGRES_USER=parry
# POSTGRES_DB=parry

# ── Caddy reverse proxy (production only) ────────────────────
# Required when running docker-compose.prod.yml
DOMAIN=parry.yourdomain.com
CADDY_EMAIL=ops@yourdomain.com

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Anthropic (LLM fallback detector) ────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Clerk (auth) ─────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# ── Stripe (billing) ─────────────────────────────────────────
# Enterprise plan is sales-led — no Stripe price ID needed.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_GROWTH=price_...
STRIPE_PRICE_ID_PRO=price_...

# ── WorkOS SSO (enterprise SAML — optional) ──────────────────
# Only needed when enterprise customers require SAML login.
# See docs/sso.md for setup instructions.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI=http://localhost:5173/auth/sso/callback

# ── Internal service auth ────────────────────────────────────
# Used for SDK → backend authentication (separate from user API keys)
PARRY_INTERNAL_SECRET=change-me

# ── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Dashboard URL (used in Slack alert links) ────────────────
DASHBOARD_URL=http://localhost:5173

# ── SMTP (email alerts) ──────────────────────────────────────
# Works with any SMTP provider: SendGrid, Mailgun, AWS SES, Postmark, Gmail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@parry.dev
SMTP_USE_TLS=true

# ── Sentry (error tracking — optional) ───────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=
# Frontend (Vite)
VITE_SENTRY_DSN=

# ── SOC 2 audit log export to S3 (optional) ──────────────────
# When configured, a monthly Celery task at 02:00 UTC on the 1st
# uploads one JSON artefact per org per month with SSE-S3. Leaving
# AUDIT_EXPORT_S3_BUCKET empty disables the export entirely.
AUDIT_EXPORT_S3_BUCKET=
AUDIT_EXPORT_S3_PREFIX=audit-log
AUDIT_EXPORT_S3_REGION=us-east-1
AUDIT_EXPORT_AWS_ACCESS_KEY_ID=
AUDIT_EXPORT_AWS_SECRET_ACCESS_KEY=

# ── On-prem / air-gapped mode (optional) ─────────────────────
# Enables license-gated, fully offline operation. When ON_PREM_MODE=true:
#   * Stripe metered usage reporting is a no-op
#   * S3 audit export is a no-op
#   * LLM fallback detector is disabled (no outbound Anthropic calls)
#   * plan_service reads limits from the signed license file
#   * Backend hard-fails on startup if the license can't be verified
# LICENSE_PUBLIC_KEY_PEM is the Ed25519 public key (override only in dev;
# production builds ship with this baked in).
ON_PREM_MODE=false
LICENSE_PATH=/etc/parry/parry.license
LICENSE_PUBLIC_KEY_PEM=

# ── Dashboard (Vite env vars — prefix with VITE_) ────────────
VITE_API_URL=http://localhost:8000
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Fernet key for encrypting probe credentials (Okta tokens etc.) at rest.
# Generate with:
#   cd backend && uv run python -c "from app.core.secret_crypto import generate_key; print(generate_key())"
# Leave empty to disable credential storage — scheduled discovery will be off.
PROBE_ENCRYPTION_KEY=
